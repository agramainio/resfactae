---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>res factae</title>
    <meta
      name="description"
      content="Things made, mostly on purpose. Objects, tools, images, machines, and process notes."
    />
    <style>
      :root {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #1d1d1b;
        background: #f7f1e4;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #f7f1e4;
      }

      main {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        padding: 32px 0 56px;
      }

      header {
        padding: 40px 0 56px;
      }

      h1 {
        margin: 0;
        font-size: clamp(56px, 14vw, 160px);
        line-height: 0.85;
        letter-spacing: -0.08em;
        font-weight: 800;
      }

      .subtitle {
        margin-top: 24px;
        max-width: 620px;
        font-size: clamp(20px, 4vw, 36px);
        line-height: 1.05;
      }

      .note {
        margin-top: 24px;
        max-width: 560px;
        font-size: 16px;
        line-height: 1.5;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }

      a.card {
        min-height: 190px;
        color: inherit;
        text-decoration: none;
        border: 1px solid #1d1d1b;
        padding: 18px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.24);
      }

      a.card:hover {
        background: #1d1d1b;
        color: #f7f1e4;
      }

      .category {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      h2 {
        margin: 0;
        font-size: 32px;
        letter-spacing: -0.04em;
      }

      .card p {
        margin: 18px 0 0;
        font-size: 15px;
        line-height: 1.35;
      }

      footer {
        margin-top: 56px;
        border-top: 1px solid #1d1d1b;
        padding-top: 18px;
        font-size: 14px;
      }

      @media (max-width: 800px) {
        main {
          width: min(100% - 24px, 560px);
          padding-top: 20px;
        }

        header {
          padding: 28px 0 36px;
        }

        .grid {
          grid-template-columns: 1fr;
        }

        a.card {
          min-height: 150px;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <header>
        <h1>res factae</h1>
        <div class="subtitle">things made, mostly on purpose.</div>
        <p class="note">
          Objects, tools, images, machines, and process notes.
          Some are finished. Some are useful. These are different categories.
        </p>
      </header>

      <section class="grid" aria-label="projects">
        {projects.map((project) => (
          <a class="card" href={project.href}>
            <div class="category">{project.category}</div>
            <div>
              <h2>{project.title}</h2>
              <p>{project.text}</p>
            </div>
          </a>
        ))}
      </section>

      <footer>
        Not a studio. Not a portfolio. More like a shelf.
      </footer>
    </main>
  </body>
</html>
