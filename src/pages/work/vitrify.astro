---
const pageTitle = 'vitrify — res factae';
const pageDescription =
  'vitrify is a res factae product in development: professional production tracking for ceramic studios.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
  </head>

  <body>
    <main class="work-page">
      <header class="topbar">
        <a href="/" class="parent">res factae</a>
        <a href="/vitrify/" class="product-link">open vitrify page</a>
      </header>

      <section class="content">
        <p class="eyebrow">Product in development</p>
        <h1>vitrify</h1>
        <p class="lede">
          Professional production tracking for ceramic studios.
        </p>

        <p>
          vitrify is a res factae product for studios that make, fire, count,
          stock, lose, repeat, and sell ceramic work. It is designed to track
          pieces, firings, losses, stock, sales outcomes, and production history.
        </p>

        <p>
          This page is the short res factae project note. The product landing
          page lives here:
        </p>

        <a class="cta" href="/vitrify/">Go to vitrify</a>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #332c26;
    background: #f4eadc;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(200, 121, 91, 0.22), transparent 30rem),
      #f4eadc;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .work-page {
    width: min(880px, calc(100% - 32px));
    margin: 0 auto;
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .topbar {
    padding: 22px 0;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #6e6258;
    font-size: 0.95rem;
  }

  .topbar a:hover {
    color: #332c26;
  }

  .content {
    align-self: center;
    padding: 70px 0 100px;
  }

  .eyebrow {
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: 0.78rem;
    font-weight: 760;
    color: #8a523e;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(4rem, 18vw, 9rem);
    line-height: 0.86;
    letter-spacing: -0.09em;
  }

  .lede {
    margin: 0 0 32px;
    max-width: 680px;
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  p {
    max-width: 680px;
    color: #4d423a;
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .cta {
    display: inline-flex;
    margin-top: 20px;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 10px;
    background: #332c26;
    color: #fff8ed;
    font-weight: 720;
  }

  .cta:hover {
    background: #1f1915;
  }

  @media (max-width: 620px) {
    .work-page {
      width: min(100% - 24px, 880px);
    }

    .topbar {
      font-size: 0.9rem;
    }

    .content {
      padding: 56px 0 80px;
    }
  }
</style>